# .agent/config.env -- repository facts for agent skills.
# Generated by bootstrap-repo.sh. Parsed line-wise, never sourced.
# Regenerate with: bootstrap-repo.sh --force

AGENT_REPO_SLUG=wrzonance/WrzDJ
AGENT_BASE_BRANCH=main
AGENT_PROJECT_OWNER=wrzonance
AGENT_PROJECT_NUMBER=3
AGENT_STATUS_VOCAB=Backlog,Ready,In progress,In review,Done
AGENT_WORKTREE_ROOT=.worktrees

# This repository's labels, for you to split by intent. Uncomment and
# classify the ones agents should reuse instead of inventing new labels.
#   bug,documentation,duplicate,enhancement,good first issue,help wanted,invalid,question,wontfix,security,dependency-drift,major-update,ai-engine,phase:v1,phase:v1.1,phase:v2,phase:v3,dependencies,python:uv,javascript
AGENT_LABEL_TYPES=bug,enhancement,documentation,security
AGENT_LABEL_AREAS=ai-engine

AGENT_CMD_TEST=server/.venv/bin/pytest --tb=short -q server/tests
AGENT_CMD_LINT=server/.venv/bin/ruff check server
AGENT_CMD_TYPECHECK=dashboard/node_modules/.bin/tsc --noEmit --project dashboard/tsconfig.json
