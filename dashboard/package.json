{
  "name": "wrzdj-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app/ lib/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "screenshots": "playwright test --config playwright.config.ts && bash ../scripts/png-to-webp.sh",
    "e2e": "playwright test --config playwright-e2e.config.ts",
    "types:export": "cd ../server && .venv/bin/python scripts/export_openapi.py",
    "types:generate": "openapi-typescript ../server/openapi.json -o lib/api-types.generated.ts"
  },
  "dependencies": {
    "@thumbmarkjs/thumbmarkjs": "^1.12.0",
    "next": "^16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-keyboard": "^3.8.192",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "vite": "^8.3.2",
    "js-yaml": "^5.0.0",
    "undici": "^8.11.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "browserslist": "~4.29.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
