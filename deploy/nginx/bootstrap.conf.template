# Temporary HTTP-only bootstrap for Let's Encrypt HTTP validation.
# Generated by: ./deploy/setup-nginx.sh when certificates are missing.

server {
    server_tokens off;
    listen 80${BOOTSTRAP_LISTEN_OPTIONS};
    server_name ${BOOTSTRAP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 503;
    }
}
